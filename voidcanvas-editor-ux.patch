+
+export function combineSelection(shape: HTMLCanvasElement, mode: 'new' | 'add' | 'sub' | 'intersect', label: string) {
+  const s = st()
+  if (mode === 'new' || !s.selection) { s.setSelection(shape, label); return }
+  const c = cloneCanvas(s.selection), x = ctx2d(c)
