+  if (kind === 'expand') out = morph(sel, px)
+  else if (kind === 'contract') out = morph(sel, -px)
+  else if (kind === 'border') { out = morph(sel, px / 2); const x = ctx2d(out); x.globalCompositeOperation = 'destination-out'; x.drawImage(morph(sel, -px / 2), 0, 0) }
