+
+export function pathToSelection(id?: string, mode: 'new' | 'add' | 'sub' | 'intersect' = 'new') {
+  const s = st(); const p = id ? s.doc?.paths?.find(x => x.id === id) : activePath(); if (!p || !s.doc) { s.notify('Draw a path with the Pen tool first.'); return }
